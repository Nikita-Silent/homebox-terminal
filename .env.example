# Base URL of the Homebox instance (without /api)
NUXT_HOMEBOX_BASE_URL=http://homebox:7745
# Homebox API token (server-side only, never exposed to the browser)
NUXT_HOMEBOX_TOKEN=
# Transfer journal (SQLite file). Keep it on a persistent volume.
NUXT_JOURNAL_PATH=./.data/journal.sqlite
# Hosts (host or host:port) the terminal is opened by, comma-separated. Protects against
# DNS rebinding. Empty allows any host — set it in production, e.g. terminal.local,192.168.1.20:3000
NUXT_ALLOWED_HOSTS=
