    "vue-router": "5.4.0",
    "zod": "4.6.7",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "quickpickle": "1.11.2",
    "shadcn-nuxt": "2.8.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
