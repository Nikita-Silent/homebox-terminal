{
  "name": "homebox-terminal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p logic/tsconfig.json && vue-tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:logic": "vitest run --project logic",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "nuxt build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@lucide/vue": "1.46.0",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "nuxt": "4.6.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.3",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "h3": "1.15.11",
    "happy-dom": "21.0.1",
    "quickpickle": "1.11.2",
    "shadcn-nuxt": "2.8.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
